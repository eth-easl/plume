{
    "benchmarkType": "trace",
    "queryStoragePrefix": "~/plume/benchmarks/tpch/queries",

    "dandelionUrl": "http://<dandelion_url>:8080",
    "requestTimeout": 30,
    "resultsPrefix": "~/plume_results/tpch_aws_trace",
    "debugPrints": false,
    "maxSplits": 30,
    "targetRowsPerSplit": 131072,

    "benchmarkConfig": {
        "path": "~/plume/benchmarks/tpch/traces/redshift_1w.csv",
        "scaleFactors": {
            "sf1": {
                "tablePathPrefix": "https://plume-exp-tpch.s3.eu-west-1.amazonaws.com/plume-tpch-sf1",
                "tablePathSuffix": ".parquet"
            },
            "sf10": {
                "tablePathPrefix": "https://plume-exp-tpch.s3.eu-west-1.amazonaws.com/plume-tpch-sf10",
                "tablePathSuffix": ".parquet"
            },
            "sf100": {
                "tablePathPrefix": "https://plume-exp-tpch.s3.eu-west-1.amazonaws.com/plume-tpch-sf100",
                "tablePathSuffix": ".parquet"
            }
        },
        "closedLoop": false
    },
    "checksumFile": "~/plume/benchmarks/tpch/config/checksums.json"
}
