{
    "benchmarkType": "trace",
    "queryStoragePrefix": "~/plume/benchmarks/tpch/queries",

    "dandelionUrl": "http://<dandelion_url>:8080",
    "requestTimeout": 30,
    "resultsPrefix": "~/plume_results/aws_trace",
    "debugPrints": false,
    "maxSplits": 30,
    "targetRowsPerSplit": 131072,

    "benchmarkConfig": {
        "path": "~/plume/benchmarks/tpch/traces/redshift_1w.csv",
        "scaleFactors": {
            "sf1": {
                "tablePathPrefix": "https://tpc-h-sf-1-ireland.s3.eu-west-1.amazonaws.com",
                "tablePathSuffix": ".parquet",
                "tableNumFiles": { "lineitem": 1, "orders": 1, "partsupp": 1 }
            },
            "sf10": {
                "tablePathPrefix": "https://tpc-h-sf-10-ireland.s3.eu-west-1.amazonaws.com",
                "tablePathSuffix": ".parquet",
                "tableNumFiles": { "lineitem": 2, "orders": 2, "partsupp": 2 }
            },
            "sf100": {
                "tablePathPrefix": "https://tpc-h-sf-100-ireland.s3.eu-west-1.amazonaws.com",
                "tablePathSuffix": ".parquet",
                "tableNumFiles": { "lineitem": 16, "orders": 16, "partsupp": 16 }
            }
        },
        "closedLoop": false
    },
    "checksumFile": "~/plume/benchmarks/tpch/config/checksums.json"
}
