{
    "benchmarkType": "throughput",
    "queries": ["q6.sql"],
    "queryStoragePrefix": "~/plume/benchmarks/tpch/queries",

    "tablePathPrefix": "https://tpc-h-sf-1-ireland.s3.eu-west-1.amazonaws.com",
    "tablePathSuffix": ".parquet",
    "tableNumFiles": { "lineitem": 1, "orders": 1, "partsupp": 1 },
    "scaleFactor": "sf1",
    "checksumFile": "~/plume/benchmarks/tpch/config/checksums.json",

    "dandelionUrl": "http://<dandelion_url>:8080",
