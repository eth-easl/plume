diff --git a/src/include/duckdb/function/aggregate/contextless_aggregate.hpp b/src/include/duckdb/function/aggregate/contextless_aggregate.hpp
new file mode 100644
index 00000000..339c7cb8
--- /dev/null
+++ b/src/include/duckdb/function/aggregate/contextless_aggregate.hpp
@@ -0,0 +1,37 @@
+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/function/aggregate/contextless_aggregate.hpp
+//
+//===----------------------------------------------------------------------===//
+
+// plume extraction patch #7: contextless aggregate binding.
+//
+// Several aggregate overloads (min/max, sum/avg over DECIMAL) carry no kernel of their own, only a bind
+// callback that picks a type-specialized implementation, and statistics propagation can swap sum for
+// sum_no_overflow. Those callbacks take a ClientContext, which plume's function binaries do not have (they
+// run with no DuckDB instance by design), and the factories they call are file-local. These entry points
+// make the same choices without a context: each shares its code with the corresponding bind callback and
+// returns the bound function (arguments and return type set as the bind leaves them).
+
+#pragma once
+
+#include "duckdb/function/aggregate_function.hpp"
+
+namespace duckdb {
+
+//! What BindMinMax binds `name` ("min" or "max") to for an input type without a collation. No bind data.
+DUCKDB_API BoundAggregateFunction GetContextlessMinMax(const string &name, const LogicalType &input_type);
+
+//! What BindDecimalSum binds sum(decimal_type) to. No bind data.
+DUCKDB_API BoundAggregateFunction GetContextlessDecimalSum(const LogicalType &decimal_type);
+
+//! What SumPropagateStats swaps a sum over an INT32/INT64-backed input (integer or DECIMAL) for when the
+//! sum provably fits in an int64. No bind data.
+DUCKDB_API BoundAggregateFunction GetContextlessSumNoOverflow(const LogicalType &input_type);
+
+//! What BindDecimalAvg binds avg(decimal_type) to; `bind_data` receives its bind data (the decimal's scale).
+DUCKDB_API BoundAggregateFunction GetContextlessDecimalAvg(const LogicalType &decimal_type,
+                                                           unique_ptr<FunctionData> &bind_data);
+
+} // namespace duckdb
