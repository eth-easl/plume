+BoundAggregateFunction GetContextlessMinMax(const string &name, const LogicalType &input_type) {
+	if (name != "min" && name != "max") {
+		throw InternalException("GetContextlessMinMax: expected min or max, got %s", name);
+	}
+	BoundAggregateFunction function(
+	    name == "min"
+	        ? GetMinMaxImplementation<MinOperation, MinOperationString, MinOperationVector>(Identifier(name), input_type)
+	        : GetMinMaxImplementation<MaxOperation, MaxOperationString, MaxOperationVector>(Identifier(name),
+	                                                                                         input_type));
+	// binding without casts (and OP_VECTOR::Bind) leaves the input type as argument and result type
+	function.GetArguments()[0] = input_type;
+	function.SetReturnType(input_type);
+	return function;
+}
